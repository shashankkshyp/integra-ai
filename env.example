# Integra.AI environment configuration
#
# Copy this file to .env.local and replace the placeholders with your own
# development credentials. Never commit .env.local or real secrets.
#
# Required variables are based on the repository README. Some integrations
# may only be needed for the features you are developing.

# ---------------------------------------------------------------------------
# Database (Neon / PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OAuth providers
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Stream Video and Chat
# ---------------------------------------------------------------------------
# Public/client-side keys may be exposed to the browser; never put secrets
# in NEXT_PUBLIC_* variables.
STREAM_API_KEY=""
STREAM_API_SECRET=""

NEXT_PUBLIC_STREAM_VIDEO_API_KEY=""
STREAM_VIDEO_SECRET_KEY=""

NEXT_PUBLIC_STREAM_CHAT_API_KEY=""
STREAM_CHAT_SECRET_KEY=""

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Inngest
# ---------------------------------------------------------------------------
INNGEST_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# Public application URL
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
